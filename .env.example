# Vercel Blob Storage (automatycznie dodawany w Vercel po kliknięciu 'Create Blob Store')
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Opcjonalny klucz bezpieczeństwa do zewnętrznych wyzwalaczy cron
SYNC_SECRET_TOKEN=twoj-tajny-token-cron-lub-worker
